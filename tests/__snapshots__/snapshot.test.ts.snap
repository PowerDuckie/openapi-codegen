exports[`all > python/http-client 1`] = `
"import http.client
import urllib.parse

parsed = urllib.parse.urlsplit("https://api.example.com/upload/42?filter%5Bname%5D=Ada&raw%5Bx%5D=y")
connection = http.client.HTTPSConnection(parsed.hostname, parsed.port or 443, timeout=30)
path = parsed.path + (("?" + parsed.query) if parsed.query else "")
headers = {
  "Authorization": "Bearer TOKEN",
  "X-Key": "KEY",
  "Cookie": "sid=cookie"
}
body = "{\\n  \\"file\\": {\\n    \\"__file\\": true,\\n    \\"path\\": \\"/tmp/file.bin\\",\\n    \\"name\\": \\"file.bin\\",\\n    \\"contentType\\": \\"application/octet-stream\\"\\n  },\\n  \\"name\\": \\"Ada\\"\\n}"
connection.request("POST", path, body=body, headers=headers)
response = connection.getresponse()
print(response.read().decode("utf-8"))"
`;

