exports[`all > go/new-request 1`] = `
"package main

import (
  "fmt"
  "io"
  "net/http"
  "strings"
)

func main() {
  req, err := http.NewRequest("POST", "https://api.example.com/upload/42?filter%5Bname%5D=Ada&raw%5Bx%5D=y", strings.NewReader("{\\n  \\"file\\": {\\n    \\"__file\\": true,\\n    \\"path\\": \\"/tmp/file.bin\\",\\n    \\"name\\": \\"file.bin\\",\\n    \\"contentType\\": \\"application/octet-stream\\"\\n  },\\n  \\"name\\": \\"Ada\\"\\n}"))
  if err != nil { panic(err) }
  req.Header.Set("Authorization", "Bearer TOKEN")
  req.Header.Set("X-Key", "KEY")
  req.Header.Set("Cookie", "sid=cookie")
  resp, err := http.DefaultClient.Do(req)
  if err != nil { panic(err) }
  defer resp.Body.Close()
  body, err := io.ReadAll(resp.Body)
  if err != nil { panic(err) }
  fmt.Println(string(body))
}"
`;

