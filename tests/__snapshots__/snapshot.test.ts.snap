# Repeated request headers and multipart fields are preserved in order.
# TODO: replace /tmp/file.bin with the real local file path for multipart field file

import asyncio
from contextlib import ExitStack
from typing import BinaryIO

import httpx


async def main() -> None:
    headers = [
        ("Authorization", "Bearer TOKEN"),
        ("X-Key", "KEY"),
        ("Cookie", "sid=cookie"),
    ]

    timeout = httpx.Timeout(30.0)

    with ExitStack() as stack:
        data: list[tuple[str, str]] = []
        files: list[tuple[str, tuple[str, BinaryIO, str]]] = []
        file_handle = stack.enter_context(open("/tmp/file.bin", "rb"))
        files.append(
            (
                "file",
                (
                    "file.bin",
                    file_handle,
                    "application/octet-stream",
                ),
            )
        )
        data.append(("name", "Ada"))

        try:
            async with httpx.AsyncClient(timeout=timeout) as client:
                response = await client.request(
                    "POST",
                    "https://api.example.com/upload/42?filter%5Bname%5D=Ada&raw%5Bx%5D=y",
                    headers=headers,
                data=data,
                files=files,
                )

                if not 200 <= response.status_code < 300:
                    raise RuntimeError(
                        f"HTTP {response.status_code}: {response.text}"
                    )

                print(response.text)
        except httpx.HTTPError as error:
            raise RuntimeError(f"HTTP request failed: {error}") from error


if __name__ == "__main__":
    asyncio.run(main())"
