"open System
open System.IO
open System.Net.Http
open System.Net.Http.Headers
open System.Text

// Requires .NET 8 SDK or later.
// Run with: dotnet run
// Standard HTTP proxy environment variables are honored.
[<EntryPoint>]
let main _ =
    use client = new HttpClient()
    client.Timeout <- TimeSpan.FromSeconds(30.0)

    use request =
        new HttpRequestMessage(
            new HttpMethod("POST"),
            "https://api.example.com/upload/42?filter%5Bname%5D=Ada&raw%5Bx%5D=y"
        )

    use multipart = new MultipartFormDataContent()
    // TODO: replace /tmp/file.bin with the real local file path for multipart field file
    let fileStream0 = File.OpenRead("/tmp/file.bin")
    let fileContent0 = new StreamContent(fileStream0)
    fileContent0.Headers.ContentType <-
        MediaTypeHeaderValue.Parse("application/octet-stream")
    multipart.Add(
        fileContent0,
        "file",
        "file.bin"
    )
    let fieldContent1 =
        new StringContent("Ada")
    multipart.Add(fieldContent1, "name")

    request.Content <- multipart

    let headerAdded0 =
        if isNull request.Content then
            request.Headers.TryAddWithoutValidation(
                "Authorization",
                "Bearer TOKEN"
            )
        else
            request.Headers.TryAddWithoutValidation(
                "Authorization",
                "Bearer TOKEN"
            )
            || request.Content.Headers.TryAddWithoutValidation(
                "Authorization",
                "Bearer TOKEN"
            )
    if not headerAdded0 then
        eprintfn "Ignored invalid header: Authorization"
    let headerAdded1 =
        if isNull request.Content then
            request.Headers.TryAddWithoutValidation(
                "X-Key",
                "KEY"
            )
        else
            request.Headers.TryAddWithoutValidation(
                "X-Key",
                "KEY"
            )
            || request.Content.Headers.TryAddWithoutValidation(
                "X-Key",
                "KEY"
            )
    if not headerAdded1 then
        eprintfn "Ignored invalid header: X-Key"
    let headerAdded2 =
        if isNull request.Content then
            request.Headers.TryAddWithoutValidation(
                "Cookie",
                "sid=cookie"
            )
        else
            request.Headers.TryAddWithoutValidation(
                "Cookie",
                "sid=cookie"
            )
            || request.Content.Headers.TryAddWithoutValidation(
                "Cookie",
                "sid=cookie"
            )
    if not headerAdded2 then
        eprintfn "Ignored invalid header: Cookie"

    try
        use response = client.Send(request)
        let responseText = response.Content.ReadAsStringAsync().Result

        if not response.IsSuccessStatusCode then
            eprintfn
                "HTTP %d %s: %s"
                (int response.StatusCode)
                response.ReasonPhrase
                responseText
            1
        else
            printfn "%s" responseText
            0
    with exception ->
        eprintfn "Request failed: %s" exception.Message
        1
    finally
        fileContent0.Dispose()
        fileStream0.Dispose()"
`;

exports[`all generators > go/new-request 1`] = `
"package main

// Requires Go 1.22 or later.
// Run with: go run .
// Standard HTTP proxy environment variables are honored.
import (
  "bytes"
  "context"
  "fmt"
  "io"
  "mime"
  "mime/multipart"
  "net/http"
  "net/textproto"
  "os"
  "time"
)

func main() {
  ctx, cancel := context.WithTimeout(
    context.Background(),
    30*time.Second,
  )
  defer cancel()

  var bodyBuffer bytes.Buffer
  multipartWriter := multipart.NewWriter(&bodyBuffer)
  // TODO: replace /tmp/file.bin with the real local file path for multipart field file
  uploadFile0, err := os.Open("/tmp/file.bin")
  if err != nil {
    fmt.Fprintf(os.Stderr, "open multipart file file: %v\\n", err)
    os.Exit(1)
  }

  fileHeader0 := make(textproto.MIMEHeader)
  fileHeader0.Set(
    "Content-Disposition",
    mime.FormatMediaType(
      "form-data",
      map[string]string{
        "name": "file",
        "filename": "file.bin",
      },
    ),
  )
  fileHeader0.Set("Content-Type", "application/octet-stream")
  filePart0, err := multipartWriter.CreatePart(fileHeader0)
  if err != nil {
    _ = uploadFile0.Close()
    fmt.Fprintf(os.Stderr, "create multipart file part file: %v\\n", err)
    os.Exit(1)
  }
  if _, err := io.Copy(filePart0, uploadFile0); err != nil {
    _ = uploadFile0.Close()
    fmt.Fprintf(os.Stderr, "copy multipart file file: %v\\n", err)
    os.Exit(1)
  }
  if err := uploadFile0.Close(); err != nil {
    fmt.Fprintf(os.Stderr, "close multipart file file: %v\\n", err)
    os.Exit(1)
  }
  if err := multipartWriter.WriteField(
    "name",
    "Ada",
  ); err != nil {
    fmt.Fprintf(os.Stderr, "write multipart field name: %v\\n", err)
    os.Exit(1)
  }
  if err := multipartWriter.Close(); err != nil {
    fmt.Fprintf(os.Stderr, "close multipart writer: %v\\n", err)
    os.Exit(1)
  }

  req, err := http.NewRequestWithContext(
    ctx,
    "POST",
    "https://api.example.com/upload/42?filter%5Bname%5D=Ada&raw%5Bx%5D=y",
    &bodyBuffer,
  )
  if err != nil {
    fmt.Fprintf(os.Stderr, "create request: %v\\n", err)
    os.Exit(1)
  }
  req.Header.Add("Authorization", "Bearer TOKEN")
  req.Header.Add("X-Key", "KEY")
  req.Header.Add("Cookie", "sid=cookie")
  req.Header.Set("Content-Type", multipartWriter.FormDataContentType())

  client := &http.Client{
    Timeout: 30 * time.Second,
  }

  resp, err := client.Do(req)
  if err != nil {
    fmt.Fprintf(os.Stderr, "perform request: %v\\n", err)
    os.Exit(1)
  }

  responseBody, readErr := io.ReadAll(resp.Body)
  closeErr := resp.Body.Close()
  if readErr != nil {
    fmt.Fprintf(os.Stderr, "read response body: %v\\n", readErr)
    os.Exit(1)
  }
  if closeErr != nil {
    fmt.Fprintf(os.Stderr, "close response body: %v\\n", closeErr)
    os.Exit(1)
  }

  if resp.StatusCode < http.StatusOK ||
    resp.StatusCode >= http.StatusMultipleChoices {
    fmt.Fprintf(os.Stderr, "HTTP %s: %s\\n",
      resp.Status,
      string(responseBody),
    )
    os.Exit(1)
  }

  fmt.Println(string(responseBody))
}"
`;

