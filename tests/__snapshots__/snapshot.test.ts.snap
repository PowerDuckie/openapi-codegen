exports[`all generators > ruby/net-http 1`] = `
"# Requires Ruby 3.1 or later.
# Uses only the Ruby standard library; no gem installation is required.
# Repeated request-header values are preserved in their original order.
# TODO: replace /tmp/file.bin with the real local file path for multipart field file

require "net/http"
require "uri"
require "securerandom"
require "stringio"

def generate_boundary
  "----ruby-net-http-#{SecureRandom.hex(24)}"
end

def escape_disposition(value)
  value
    .gsub("\\\\", "\\\\\\\\")
    .gsub('"', '\\\\"')
    .gsub(/[\\r\\n]/, "")
end

def encode_multipart(entries, boundary)
  body = +"".b

  entries.each do |entry|
    body << "--#{boundary}\\r\\n".b
    disposition = (
      'Content-Disposition: form-data; name="' +
      escape_disposition(entry.fetch(:name)) +
      '"'
    )

    if entry.key?(:path)
      disposition << (
        '; filename="' +
        escape_disposition(entry.fetch(:filename)) +
        '"'
      )
    end

    body << "#{disposition}\\r\\n".b

    if entry.key?(:content_type)
      content_type = entry.fetch(:content_type)
      body << "Content-Type: #{content_type}\\r\\n".b
    end

    body << "\\r\\n".b

    if entry.key?(:path)
      File.open(entry.fetch(:path), 'rb') do |file|
        IO.copy_stream(file, StringIO.new(body))
      end
    else
      body << entry.fetch(:value).encode(
        Encoding::UTF_8,
        invalid: :replace,
        undef: :replace,
      )
    end

    body << "\\r\\n".b
  end

  body << "--#{boundary}--\\r\\n".b
  body
end

def main
  uri = URI.parse('https://api.example.com/upload/42?filter%5Bname%5D=Ada&raw%5Bx%5D=y')

  unless %w[http https].include?(uri.scheme)
    raise ArgumentError, (
      "unsupported URL scheme: #{uri.scheme || 'missing'}"
    )
  end

  raise ArgumentError, "URL must include a host" unless uri.host

  request = Net::HTTPGenericRequest.new(
    'POST',
    true,
    true,
    uri.request_uri.empty? ? '/' : uri.request_uri,
  )

  header_items = [
  ['Authorization', 'Bearer TOKEN'],
  ['X-Key', 'KEY'],
  ['Cookie', 'sid=cookie'],
  ]

  header_items.each do |name, value|
    request.add_field(name, value)
  end

  multipart_entries = [
    {
      name: 'file',
      path: '/tmp/file.bin',
      filename: 'file.bin',
      content_type: 'application/octet-stream',
    },
    {
      name: 'name',
      value: 'Ada',
    },
  ]

  boundary = generate_boundary
  request.body = encode_multipart(
    multipart_entries,
    boundary,
  )
  request['Content-Type'] = (
    "multipart/form-data; boundary=#{boundary}"
  )

  http = Net::HTTP.new(uri.host, uri.port)
  http.use_ssl = uri.scheme == 'https'
  http.open_timeout = 30
  http.read_timeout = 30
  http.write_timeout = 30

  response = http.start do |connection|
    connection.request(request)
  end

  unless response.is_a?(Net::HTTPSuccess)
    raise RuntimeError, (
      "HTTP #{response.code} #{response.message}: #{response.body}"
    )
  end

  puts response.body
rescue URI::InvalidURIError,
       SocketError,
       SystemCallError,
       IOError,
       Timeout::Error,
       Net::HTTPBadResponse,
       Net::HTTPHeaderSyntaxError,
       Net::ProtocolError => error
  raise RuntimeError, "HTTP request failed: #{error.message}"
end

main if $PROGRAM_NAME == __FILE__"
`;

exports[`all generators > rust/reqwest 1`] = `
"// Requires Rust 1.74 or later.
// Requires reqwest 0.12 or later.
//
// Cargo.toml:
// reqwest = { version = "0.12", features = ["blocking", "multipart"] }
//
// Repeated request headers and multipart fields are preserved in order.
// TODO: replace /tmp/file.bin with the real local file path for multipart field file

use reqwest::blocking::Client;
use reqwest::header::{HeaderMap, HeaderName, HeaderValue};
use reqwest::Method;
use std::fs::File;
use std::error::Error;
use std::io;
use std::time::Duration;


fn main() -> Result<(), Box<dyn Error>> {
    let client = Client::builder()
        .connect_timeout(Duration::from_secs(30))
        .timeout(Duration::from_secs(30))
        .build()?;

    let mut headers = HeaderMap::new();
    {
        let name = HeaderName::from_bytes("Authorization".as_bytes())?;
        let value = HeaderValue::from_str("Bearer TOKEN")?;
        headers.append(name, value);
    }
    {
        let name = HeaderName::from_bytes("X-Key".as_bytes())?;
        let value = HeaderValue::from_str("KEY")?;
        headers.append(name, value);
    }
    {
        let name = HeaderName::from_bytes("Cookie".as_bytes())?;
        let value = HeaderValue::from_str("sid=cookie")?;
        headers.append(name, value);
    }

    let method = Method::from_bytes("POST".as_bytes())?;

    let mut multipart_form = reqwest::blocking::multipart::Form::new();
    {
        let file = File::open("/tmp/file.bin")?;
        let part = reqwest::blocking::multipart::Part::reader(file)
            .file_name("file.bin")
            .mime_str("application/octet-stream")?;
        multipart_form = multipart_form.part(
            "file",
            part,
        );
    }
    multipart_form = multipart_form.text(
        "name",
        "Ada".to_owned(),
    );

    let request = client
        .request(method, "https://api.example.com/upload/42?filter%5Bname%5D=Ada&raw%5Bx%5D=y")
        .headers(headers)
        .multipart(multipart_form)
        .build()?;

    let response = client.execute(request)?;
    let status = response.status();
    let response_body = response.text()?;

    if !status.is_success() {
        return Err(io::Error::other(format!(
            "HTTP {}: {}",
            status,
            response_body,
        ))
        .into());
    }

    println!("{}", response_body);
    Ok(())
}"
`;

