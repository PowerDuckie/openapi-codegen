import kong.unirest.Unirest;

// Requires JDK 17+ and com.konghq:unirest-java:3.14.5.
// Compile and run with the Unirest dependency and its transitive dependencies on the classpath.
// Proxy and TLS behavior can be configured through Unirest.config() when required.
// TODO: replace /tmp/file.bin with the real local file path for multipart field file
public final class Example {
  private Example() {}

  public static void main(String[] args) {
    int exitCode = 0;

    try {
      Unirest.config()
        .connectTimeout(30_000)
        .requestTimeout(30_000);

      HttpRequest<?> httpRequest =
        Unirest.request("POST", "https://api.example.com/upload/42?filter%5Bname%5D=Ada&raw%5Bx%5D=y")
        .header("Authorization", "Bearer TOKEN")
        .header("X-Key", "KEY")
        .header("Cookie", "sid=cookie")
        .field(
        "file",
        new File("/tmp/file.bin")
      )
        .field(
        "name",
        "Ada"
      );

      HttpResponse<String> response = httpRequest.asString();
      String responseText = response.getBody() == null
        ? ""
        : response.getBody();

      if (!response.isSuccess()) {
        System.err.println(
          "HTTP " + response.getStatus() + " "
            + response.getStatusText() + ": " + responseText
        );
        exitCode = 1;
      } else {
        System.out.println(responseText);
      }
    } catch (RuntimeException exception) {
      exception.printStackTrace();
      exitCode = 1;
    } finally {
      Unirest.shutDown();
    }

    if (exitCode != 0) {
      System.exit(exitCode);
    }
  }
}"
`;

