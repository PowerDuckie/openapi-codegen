"import org.asynchttpclient.*;
import static org.asynchttpclient.Dsl.*;

public class Example {
  public static void main(String[] args) throws Exception {
    try (AsyncHttpClient client = asyncHttpClient()) {
      BoundRequestBuilder request = client.prepare("POST", "https://api.example.com/upload/42?filter%5Bname%5D=Ada&raw%5Bx%5D=y");
      request.addHeader("Authorization", "Bearer TOKEN");
      request.addHeader("X-Key", "KEY");
      request.addHeader("Cookie", "sid=cookie");
      request.setBody("{\\n  \\"file\\": {\\n    \\"__file\\": true,\\n    \\"path\\": \\"/tmp/file.bin\\",\\n    \\"name\\": \\"file.bin\\",\\n    \\"contentType\\": \\"application/octet-stream\\"\\n  },\\n  \\"name\\": \\"Ada\\"\\n}");
      Response response = request.execute().get();
      System.out.println(response.getResponseBody());
    }
  }
}"
`;

exports[`all > java/java-net-http 1`] = `
"import java.net.URI;
import java.net.http.HttpClient;
import java.net.http.HttpRequest;
import java.net.http.HttpResponse;

public class Example {
  public static void main(String[] args) throws Exception {
    HttpClient client = HttpClient.newHttpClient();
    HttpRequest.Builder builder = HttpRequest.newBuilder()
      .uri(URI.create("https://api.example.com/upload/42?filter%5Bname%5D=Ada&raw%5Bx%5D=y"));
    builder.header("Authorization", "Bearer TOKEN");
    builder.header("X-Key", "KEY");
    builder.header("Cookie", "sid=cookie");
    HttpRequest request = builder.method("POST", HttpRequest.BodyPublishers.ofString("{\\n  \\"file\\": {\\n    \\"__file\\": true,\\n    \\"path\\": \\"/tmp/file.bin\\",\\n    \\"name\\": \\"file.bin\\",\\n    \\"contentType\\": \\"application/octet-stream\\"\\n  },\\n  \\"name\\": \\"Ada\\"\\n}")).build();
    HttpResponse<String> response = client.send(request, HttpResponse.BodyHandlers.ofString());
    System.out.println(response.body());
  }
}"
`;

exports[`all > java/okhttp 1`] = `
"import okhttp3.*;

public class Example {
  public static void main(String[] args) throws Exception {
    OkHttpClient client = new OkHttpClient();
    RequestBody body = RequestBody.create("{\\n  \\"file\\": {\\n    \\"__file\\": true,\\n    \\"path\\": \\"/tmp/file.bin\\",\\n    \\"name\\": \\"file.bin\\",\\n    \\"contentType\\": \\"application/octet-stream\\"\\n  },\\n  \\"name\\": \\"Ada\\"\\n}", MediaType.parse("multipart/form-data"));
    Request.Builder builder = new Request.Builder().url("https://api.example.com/upload/42?filter%5Bname%5D=Ada&raw%5Bx%5D=y");
    builder.addHeader("Authorization", "Bearer TOKEN");
    builder.addHeader("X-Key", "KEY");
    builder.addHeader("Cookie", "sid=cookie");
    builder.method("POST", body);
    try (Response response = client.newCall(builder.build()).execute()) {
      System.out.println(response.body().string());
    }
  }
}"
`;

