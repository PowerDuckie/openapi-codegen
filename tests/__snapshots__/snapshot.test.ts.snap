exports[`all generators > powershell/invoke-restmethod 1`] = `
"# Requires PowerShell 7.4 or later.
# Multipart uploads require Invoke-RestMethod -Form support.
# Repeated request-header values are combined with commas.
# Multipart file name and media-type overrides are not supported by -Form.

# TODO: replace /tmp/file.bin with the real local file path for multipart field file

$headers = @{}
$headers['Authorization'] = 'Bearer TOKEN'
$headers['X-Key'] = 'KEY'
$headers['Cookie'] = 'sid=cookie'

$parameters = @{
  Method = 'POST'
  Uri = 'https://api.example.com/upload/42?filter%5Bname%5D=Ada&raw%5Bx%5D=y'
  Headers = $headers
  TimeoutSec = 30
  ErrorAction = 'Stop'
}

$form = [ordered]@{}
$form['file'] = Get-Item -LiteralPath '/tmp/file.bin' -ErrorAction Stop
$form['name'] = 'Ada'

$parameters['Form'] = $form

try {
  $response = Invoke-RestMethod @parameters

  if ($null -ne $response) {
    $response | ConvertTo-Json -Depth 100
  }
} catch {
  $statusCode = $null
  $responseBody = $null

  if ($null -ne $_.Exception.Response) {
    $statusCode = [int]$_.Exception.Response.StatusCode
  }

  if ($null -ne $_.ErrorDetails -and $_.ErrorDetails.Message) {
    $responseBody = $_.ErrorDetails.Message
  }

  if ($null -ne $statusCode) {
    $message = "HTTP \${statusCode}: \${responseBody}"
  } else {
    $message = $_.Exception.Message
  }

  throw [System.Net.Http.HttpRequestException]::new(
    $message,
    $_.Exception
  )
}"
`;

