exports[`all > c/libcurl 1`] = `
"#include <curl/curl.h>
#include <stdio.h>
int main(void) {
  CURL *curl = curl_easy_init();
  if (!curl) return 1;
  curl_easy_setopt(curl, CURLOPT_URL, "https://api.example.com/upload/42?filter%5Bname%5D=Ada&raw%5Bx%5D=y");
  curl_easy_setopt(curl, CURLOPT_CUSTOMREQUEST, "POST");
  /* header: Authorization: Bearer TOKEN */
  /* header: X-Key: KEY */
  /* header: Cookie: sid=cookie */
  curl_easy_setopt(curl, CURLOPT_POSTFIELDS, "{\\n  \\"file\\": {\\n    \\"__file\\": true,\\n    \\"path\\": \\"/tmp/file.bin\\",\\n    \\"name\\": \\"file.bin\\",\\n    \\"contentType\\": \\"application/octet-stream\\"\\n  },\\n  \\"name\\": \\"Ada\\"\\n}");
  curl_easy_perform(curl);
  curl_easy_cleanup(curl);
  return 0;
}"
`;

