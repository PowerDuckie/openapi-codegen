exports[`all > objc/nsurlsession 1`] = `
"@import Foundation;
int main() {
  @autoreleasepool {
    NSMutableURLRequest *request = [NSMutableURLRequest requestWithURL:[NSURL URLWithString:@"https://api.example.com/upload/42?filter%5Bname%5D=Ada&raw%5Bx%5D=y"]];
    request.HTTPMethod = @"POST";
    [request setValue:@"Bearer TOKEN" forHTTPHeaderField:@"Authorization"];
    [request setValue:@"KEY" forHTTPHeaderField:@"X-Key"];
    [request setValue:@"sid=cookie" forHTTPHeaderField:@"Cookie"];
    request.HTTPBody = [@"{\\n  \\"file\\": {\\n    \\"__file\\": true,\\n    \\"path\\": \\"/tmp/file.bin\\",\\n    \\"name\\": \\"file.bin\\",\\n    \\"contentType\\": \\"application/octet-stream\\"\\n  },\\n  \\"name\\": \\"Ada\\"\\n}" dataUsingEncoding:NSUTF8StringEncoding];
    dispatch_semaphore_t semaphore = dispatch_semaphore_create(0);
    [[[NSURLSession sharedSession] dataTaskWithRequest:request completionHandler:^(NSData *data, NSURLResponse *response, NSError *error) {
      if (error) { NSLog(@"%@", error); dispatch_semaphore_signal(semaphore); return; }
      NSString *text = [[NSString alloc] initWithData:data encoding:NSUTF8StringEncoding];
      NSLog(@"%@", text);
      dispatch_semaphore_signal(semaphore);
    }] resume];
    dispatch_semaphore_wait(semaphore, DISPATCH_TIME_FOREVER);
  }
  return 0;
}"
`;

exports[`all > ocaml/cohttp 1`] = `
"open Cohttp
open Cohttp_lwt_unix
open Lwt.Infix

let () =
  let uri = Uri.of_string "https://api.example.com/upload/42?filter%5Bname%5D=Ada&raw%5Bx%5D=y" in
  let headers = Header.of_list [
    ("Authorization", "Bearer TOKEN");
    ("X-Key", "KEY");
    ("Cookie", "sid=cookie");
  ] in
  let body = Cohttp_lwt.Body.of_string "{\\n  \\"file\\": {\\n    \\"__file\\": true,\\n    \\"path\\": \\"/tmp/file.bin\\",\\n    \\"name\\": \\"file.bin\\",\\n    \\"contentType\\": \\"application/octet-stream\\"\\n  },\\n  \\"name\\": \\"Ada\\"\\n}" in
  Lwt_main.run (
    Client.call ~headers ~body \`POST\` uri >>= fun (_, body) ->
    Cohttp_lwt.Body.to_string body >|= print_endline
  )"
`;

