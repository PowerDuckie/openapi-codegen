exports[`all generators > c/libcurl 1`] = `
"#include <curl/curl.h>
#include <stdio.h>

/* Requires libcurl development headers and library. */
/* Build: cc example.c -o example $(pkg-config --cflags --libs libcurl) */
/* Proxy and TLS trust settings may be read from the environment. */
/* TODO: replace /tmp/file.bin with the real local file path for multipart field file */

int main(void) {
  int exit_code = 0;
  CURLcode result;
  long status = 0;
  struct curl_slist *headers = NULL;
  curl_mime *mime = NULL;

  if (curl_global_init(CURL_GLOBAL_DEFAULT) != CURLE_OK) {
    fprintf(stderr, "Failed to initialize libcurl\\n");
    return 1;
  }

  CURL *curl = curl_easy_init();
  if (!curl) {
    fprintf(stderr, "Failed to create libcurl handle\\n");
    curl_global_cleanup();
    return 1;
  }

  mime = curl_mime_init(curl);
  if (!mime) {
    fprintf(stderr, "Failed to create multipart body\\n");
    exit_code = 1;
    goto cleanup;
  }

  curl_easy_setopt(curl, CURLOPT_URL, "https://api.example.com/upload/42?filter%5Bname%5D=Ada&raw%5Bx%5D=y");
  curl_easy_setopt(curl, CURLOPT_CUSTOMREQUEST, "POST");
  curl_easy_setopt(curl, CURLOPT_CONNECTTIMEOUT, 30L);
  curl_easy_setopt(curl, CURLOPT_TIMEOUT, 30L);
  curl_easy_setopt(curl, CURLOPT_FOLLOWLOCATION, 1L);
  curl_easy_setopt(curl, CURLOPT_NOSIGNAL, 1L);
  curl_easy_setopt(curl, CURLOPT_WRITEFUNCTION, fwrite);
  curl_easy_setopt(curl, CURLOPT_WRITEDATA, stdout);

  headers = curl_slist_append(headers, "Authorization: Bearer TOKEN");
  if (!headers) {
    fprintf(stderr, "Failed to allocate request headers\\n");
    exit_code = 1;
    goto cleanup;
  }
  headers = curl_slist_append(headers, "X-Key: KEY");
  if (!headers) {
    fprintf(stderr, "Failed to allocate request headers\\n");
    exit_code = 1;
    goto cleanup;
  }
  headers = curl_slist_append(headers, "Cookie: sid=cookie");
  if (!headers) {
    fprintf(stderr, "Failed to allocate request headers\\n");
    exit_code = 1;
    goto cleanup;
  }

  curl_mimepart *part0 = curl_mime_addpart(mime);
  if (!part0) {
    fprintf(stderr, "Failed to allocate multipart field\\n");
    exit_code = 1;
    goto cleanup;
  }
  if (curl_mime_name(part0, "file") != CURLE_OK) {
    fprintf(stderr, "Failed to set multipart field name\\n");
    exit_code = 1;
    goto cleanup;
  }
  if (curl_mime_filedata(part0, "/tmp/file.bin") != CURLE_OK ||
      curl_mime_filename(part0, "file.bin") != CURLE_OK ||
      curl_mime_type(part0, "application/octet-stream") != CURLE_OK) {
    fprintf(stderr, "Failed to configure multipart file\\n");
    exit_code = 1;
    goto cleanup;
  }
  curl_mimepart *part1 = curl_mime_addpart(mime);
  if (!part1) {
    fprintf(stderr, "Failed to allocate multipart field\\n");
    exit_code = 1;
    goto cleanup;
  }
  if (curl_mime_name(part1, "name") != CURLE_OK) {
    fprintf(stderr, "Failed to set multipart field name\\n");
    exit_code = 1;
    goto cleanup;
  }
  if (curl_mime_data(part1, "Ada", CURL_ZERO_TERMINATED) != CURLE_OK) {
    fprintf(stderr, "Failed to configure multipart field\\n");
    exit_code = 1;
    goto cleanup;
  }

  curl_easy_setopt(curl, CURLOPT_MIMEPOST, mime);
  if (headers) {
    curl_easy_setopt(curl, CURLOPT_HTTPHEADER, headers);
  }

  result = curl_easy_perform(curl);
  if (result != CURLE_OK) {
    fprintf(stderr, "Request failed: %s\\n", curl_easy_strerror(result));
    exit_code = 1;
    goto cleanup;
  }

  if (curl_easy_getinfo(curl, CURLINFO_RESPONSE_CODE, &status) != CURLE_OK) {
    fprintf(stderr, "Failed to read HTTP status\\n");
    exit_code = 1;
    goto cleanup;
  }

  if (status < 200 || status >= 300) {
    fprintf(stderr, "\\nHTTP request failed with status %ld\\n", status);
    exit_code = 1;
  }

cleanup:
  curl_mime_free(mime);
  curl_slist_free_all(headers);
  curl_easy_cleanup(curl);
  curl_global_cleanup();
  return exit_code;
}"
`;

