exports[`all > kotlin/okhttp 1`] = `
"import okhttp3.*

fun main() {
  val client = OkHttpClient()
  val body = "multipart/form-data".toMediaType().let { mediaType -> "{\\n  \\"file\\": {\\n    \\"__file\\": true,\\n    \\"path\\": \\"/tmp/file.bin\\",\\n    \\"name\\": \\"file.bin\\",\\n    \\"contentType\\": \\"application/octet-stream\\"\\n  },\\n  \\"name\\": \\"Ada\\"\\n}".toRequestBody(mediaType) }
  val builder = Request.Builder().url("https://api.example.com/upload/42?filter%5Bname%5D=Ada&raw%5Bx%5D=y")
  builder.addHeader("Authorization", "Bearer TOKEN")
  builder.addHeader("X-Key", "KEY")
  builder.addHeader("Cookie", "sid=cookie")
  builder.method("POST", body)
  client.newCall(builder.build()).execute().use { response ->
    println(response.body!!.string())
  }
}"
`;

